<UserControl x:Class="BlueParlour.Desktop.OperaView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <TextBlock Text="THE MIDNIGHT OPERA · MEMORY CHALLENGE" FontSize="10" Foreground="#7B6546"/>
  <DockPanel Margin="0,5,0,1"><TextBlock Text="{Binding Lights}" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12"/><TextBlock Text="{Binding Scene}" FontFamily="Georgia" FontSize="25"/></DockPanel>
  <TextBlock Text="{Binding Challenge}" FontSize="12" Margin="0,0,0,5"/>
  <Border Background="#172E48" CornerRadius="10" Height="55" Margin="0,0,0,5">
   <Viewbox><Canvas Width="560" Height="100">
    <Path Data="M0,0 L130,0 Q120,65 25,95 L0,100Z M560,0 L430,0 Q440,65 535,95 L560,100Z" Fill="#712D46"/>
    <Path Data="M0,0 Q280,55 560,0" Stroke="#C7A969" StrokeThickness="5"/>
    <Ellipse Canvas.Left="215" Canvas.Top="68" Width="135" Height="24" Fill="#406681"/>
    <Path Data="M258,27 Q280,15 302,27 L299,54 Q280,80 261,54Z" Fill="#E9DEBF"/>
    <Path Data="M264,38 Q270,32 277,39 M284,39 Q292,32 297,38" Stroke="#172E48" StrokeThickness="4"/>
    <Canvas Opacity="{Binding Glow}"><Ellipse Canvas.Left="146" Canvas.Top="45" Width="24" Height="34" Fill="#E4BC73"/><Ellipse Canvas.Left="391" Canvas.Top="45" Width="24" Height="34" Fill="#E4BC73"/><Ellipse Canvas.Left="271" Canvas.Top="4" Width="18" Height="18" Fill="#F9DE99"/></Canvas>
   </Canvas></Viewbox>
  </Border>
  <ItemsControl ItemsSource="{Binding Cards}">
   <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate><DataTemplate>
    <Button Command="{Binding Choose}" Background="{Binding Background}" Margin="3" Padding="3" Height="70" AutomationProperties.Name="{Binding AccessibleLabel}" AutomationProperties.HelpText="{Binding State}">
     <Grid>
      <StackPanel Visibility="{Binding IsHidden, Converter={StaticResource Visible}}">
       <Border Width="38" Height="38" CornerRadius="19" BorderBrush="#C9AC76" BorderThickness="2"><TextBlock Text="?" Foreground="#EAD9B9" FontFamily="Georgia" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <TextBlock Text="Face down" Foreground="#CFDCE3" HorizontalAlignment="Center" FontSize="9" Margin="0,2,0,0"/>
      </StackPanel>
      <StackPanel Visibility="{Binding IsVisible, Converter={StaticResource Visible}}">
       <Grid Width="44" Height="39">
        <Canvas Visibility="{Binding IsMask, Converter={StaticResource Visible}}"><Path Data="M4,3 Q22,-2 40,3 L37,23 Q22,42 7,23Z" Fill="#DDD0AE" Stroke="#806E4E"/><Path Data="M10,14 Q16,8 20,14 M25,14 Q31,8 36,14" Stroke="#253E53" StrokeThickness="3"/></Canvas>
        <Canvas Visibility="{Binding IsRose, Converter={StaticResource Visible}}"><Path Data="M22,38 L22,16 M22,30 L34,23" Stroke="#41745F" StrokeThickness="3"/><Ellipse Canvas.Left="8" Width="29" Height="24" Fill="#94364B"/><Path Data="M14,12 Q22,0 31,12 Q23,25 14,12" Stroke="#DDA0A4" StrokeThickness="2"/></Canvas>
        <Canvas Visibility="{Binding IsCandle, Converter={StaticResource Visible}}"><Rectangle Canvas.Left="17" Canvas.Top="17" Width="12" Height="21" Fill="#C5A56B"/><Path Data="M23,0 Q36,18 23,19 Q13,17 23,0Z" Fill="#C7882E"/></Canvas>
        <Canvas Visibility="{Binding IsKey, Converter={StaticResource Visible}}"><Ellipse Canvas.Left="2" Canvas.Top="5" Width="19" Height="19" Stroke="#A77D30" StrokeThickness="5"/><Path Data="M18,20 L39,37 M29,30 L34,25 M34,35 L39,30" Stroke="#A77D30" StrokeThickness="5"/></Canvas>
        <TextBlock Text="♫" Visibility="{Binding IsMusic, Converter={StaticResource Visible}}" Foreground="#456A86" FontFamily="Georgia" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Canvas Visibility="{Binding IsMoon, Converter={StaticResource Visible}}"><Ellipse Width="37" Height="37" Fill="#D8B870"/><Ellipse Canvas.Left="-7" Canvas.Top="-5" Width="35" Height="35" Fill="#FFFAEF"/></Canvas>
       </Grid>
       <TextBlock Text="{Binding State}" HorizontalAlignment="Center" FontSize="9"/>
      </StackPanel>
     </Grid>
    </Button>
   </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <TextBlock Text="{Binding Message}" FontSize="12" LineHeight="17" MinHeight="37" Margin="0,5,0,2"/>
  <StackPanel Orientation="Horizontal">
   <Button Content="Lower the curtain  ↓" Command="{Binding Continue}" Visibility="{Binding AwaitingCurtain, Converter={StaticResource Visible}}" Background="#244F73" Foreground="White" Padding="12,7" Margin="0,0,8,0"/>
   <Button Content="Begin the next act  →" Command="{Binding NextAct}" Visibility="{Binding HasNextAct, Converter={StaticResource Visible}}" Background="#244F73" Foreground="White" Padding="12,7" Margin="0,0,8,0"/>
   <Button Content="Encore · replay all acts  ↻" Command="{Binding Replay}" Visibility="{Binding IsCurtainCall, Converter={StaticResource Visible}}" Padding="12,7"/>
  </StackPanel>
 </StackPanel>
</UserControl>
