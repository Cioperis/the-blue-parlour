<UserControl x:Class="BlueParlour.Desktop.OperaView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <TextBlock Text="THE MIDNIGHT OPERA" FontSize="11" Foreground="#7B6546"/>
  <DockPanel Margin="0,8,0,4"><TextBlock Text="{Binding Lights}" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12"/><TextBlock Text="{Binding Scene}" FontFamily="Georgia" FontSize="29"/></DockPanel>
  <TextBlock Text="Match three pairs to light the theatre. No clock, no score, no surprises." FontSize="13" Margin="0,0,0,8"/>
  <Border Background="#172E48" CornerRadius="12" Height="66" Margin="0,0,0,8">
   <Viewbox><Canvas Width="560" Height="100">
    <Path Data="M0,0 L130,0 Q120,65 25,95 L0,100Z M560,0 L430,0 Q440,65 535,95 L560,100Z" Fill="#712D46"/>
    <Path Data="M0,0 Q280,55 560,0" Stroke="#C7A969" StrokeThickness="5"/>
    <Ellipse Canvas.Left="215" Canvas.Top="68" Width="135" Height="24" Fill="#406681"/>
    <Path Data="M258,27 Q280,15 302,27 L299,54 Q280,80 261,54Z" Fill="#E9DEBF"/>
    <Path Data="M264,38 Q270,32 277,39 M284,39 Q292,32 297,38" Stroke="#172E48" StrokeThickness="4"/>
    <Path Data="M274,56 Q281,59 287,54" Stroke="#976B64" StrokeThickness="2"/>
    <Canvas Opacity="{Binding Glow}">
     <Ellipse Canvas.Left="146" Canvas.Top="45" Width="24" Height="34" Fill="#E4BC73"/>
     <Ellipse Canvas.Left="391" Canvas.Top="45" Width="24" Height="34" Fill="#E4BC73"/>
     <Ellipse Canvas.Left="271" Canvas.Top="4" Width="18" Height="18" Fill="#F9DE99"/>
    </Canvas>
    <Path Data="M158,81 L158,65 M403,81 L403,65" Stroke="#E7D6B4" StrokeThickness="8"/>
   </Canvas></Viewbox>
  </Border>
  <ItemsControl ItemsSource="{Binding Cards}">
   <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate><DataTemplate>
    <Button Command="{Binding Choose}" Background="{Binding Background}" Margin="4" Padding="5,7" Height="90" AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding State}">
     <StackPanel>
      <Grid Width="64" Height="40">
       <Canvas Visibility="{Binding IsMask, Converter={StaticResource Visible}}">
        <Path Data="M6,5 Q32,-3 58,5 L54,30 Q32,55 10,30Z" Fill="#DDD0AE" Stroke="#806E4E" StrokeThickness="1.5"/>
        <Path Data="M15,18 Q23,10 29,18 M36,18 Q43,10 51,18" Stroke="#253E53" StrokeThickness="4"/>
        <Path Data="M25,33 Q32,37 39,31" Stroke="#94364B" StrokeThickness="2"/>
       </Canvas>
       <Canvas Visibility="{Binding IsRose, Converter={StaticResource Visible}}">
        <Path Data="M32,46 L32,20 M32,37 L46,29" Stroke="#41745F" StrokeThickness="3"/>
        <Ellipse Canvas.Left="15" Canvas.Top="0" Width="34" Height="29" Fill="#94364B"/>
        <Path Data="M22,15 Q31,-1 40,14 Q33,28 22,15 M27,14 Q36,7 36,19" Stroke="#DDA0A4" StrokeThickness="2"/>
       </Canvas>
       <Canvas Visibility="{Binding IsCandle, Converter={StaticResource Visible}}">
        <Rectangle Canvas.Left="25" Canvas.Top="20" Width="15" Height="26" Fill="#C5A56B"/>
        <Path Data="M32,1 Q49,22 32,23 Q20,20 32,1Z" Fill="#C7882E"/>
        <Path Data="M32,11 Q40,22 32,22 Q27,20 32,11Z" Fill="#FFE1A5"/>
       </Canvas>
      </Grid>
      <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontFamily="Georgia" FontSize="17"/>
      <TextBlock Text="{Binding State}" HorizontalAlignment="Center" FontSize="10" Margin="0,4,0,0"/>
     </StackPanel>
    </Button>
   </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <TextBlock Text="{Binding Message}" FontSize="13" LineHeight="19" MinHeight="44" Margin="0,8,0,4"/>
  <Button Content="Another little scene  ↻" Command="{Binding Replay}" Visibility="{Binding Complete, Converter={StaticResource Visible}}" HorizontalAlignment="Left" Padding="12,8"/>
 </StackPanel>
</UserControl>
