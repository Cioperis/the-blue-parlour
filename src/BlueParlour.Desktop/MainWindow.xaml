<Window x:Class="BlueParlour.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="The Blue Parlour" Width="1180" Height="800" MinWidth="820" MinHeight="600"
 Background="#142E45" Foreground="#233B50" WindowStartupLocation="CenterScreen" PreviewKeyDown="OnKeyDown">
 <Border Background="#142E45">
 <Viewbox Stretch="Uniform">
 <Grid Width="1140" Height="720" Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="24,0">
   <StackPanel VerticalAlignment="Center">
    <TextBlock Text="THE BLUE PARLOUR" Foreground="#F2E4CD" FontFamily="Georgia" FontSize="30"/>
    <TextBlock Text="A LITTLE CURIOSITY. A LITTLE COLOUR. A MOMENT FOR YOURSELF." Foreground="#ADC5D7" FontSize="10" Margin="1,9,0,0"/>
   </StackPanel>
   <Border HorizontalAlignment="Right" VerticalAlignment="Center" BorderBrush="#658299" BorderThickness="1" CornerRadius="20" Padding="18,9">
    <TextBlock Text="{Binding Collection}" Foreground="#E2CFAB" FontSize="12"/>
   </Border>
  </Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="365"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#254B6A" CornerRadius="16" BorderBrush="#658299" BorderThickness="1">
    <Grid Margin="22">
     <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="330"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="YOUR QUIET CORNER" Foreground="#E2CFAB" FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0"/>
     <Canvas Grid.Row="1" Width="318" Height="320" ClipToBounds="True">
      <!-- Original vector illustration: moonlit sash window, desk, sleeping cat. -->
      <Rectangle Width="220" Height="222" Canvas.Left="48" Canvas.Top="12" RadiusX="95" RadiusY="95" Fill="#A18E6D"/>
      <Rectangle Width="204" Height="206" Canvas.Left="56" Canvas.Top="20" RadiusX="90" RadiusY="90" Fill="#142E45"/>
      <Ellipse Width="38" Height="38" Canvas.Left="191" Canvas.Top="44" Fill="#E3D2AD"/>
      <Ellipse Width="33" Height="33" Canvas.Left="182" Canvas.Top="38" Fill="#142E45"/>
      <Path Data="M65,180 Q110,115 149,178 Q202,105 252,173 L252,220 L65,220Z" Fill="#355773"/>
      <Rectangle Width="6" Height="210" Canvas.Left="156" Canvas.Top="18" Fill="#A18E6D"/>
      <Rectangle Width="209" Height="6" Canvas.Left="54" Canvas.Top="124" Fill="#A18E6D"/>
      <Rectangle Width="240" Height="10" Canvas.Left="38" Canvas.Top="221" Fill="#C1AD86" RadiusX="3" RadiusY="3"/>
      <Rectangle Width="286" Height="13" Canvas.Left="16" Canvas.Top="278" Fill="#AD8C69" RadiusX="5" RadiusY="5"/>
      <Rectangle Width="10" Height="50" Canvas.Left="36" Canvas.Top="291" Fill="#806952"/>
      <Rectangle Width="10" Height="50" Canvas.Left="274" Canvas.Top="291" Fill="#806952"/>
      <Path Data="M37,273 L41,232 L69,232 L73,273Z" Fill="#A6C5D5"/>
      <Path Data="M55,237 L51,199 M54,224 L69,209 M53,216 L38,205" Stroke="#769582" StrokeThickness="3"/>
      <Canvas Visibility="{Binding HasRose, Converter={StaticResource Visible}}">
       <Ellipse Width="28" Height="23" Canvas.Left="37" Canvas.Top="183" Fill="#772B42"/>
       <Ellipse Width="17" Height="15" Canvas.Left="47" Canvas.Top="185" Fill="#A7475B"/>
       <Path Data="M47,197 Q57,183 59,199 Q46,207 43,194" Stroke="#D27A86" StrokeThickness="1.5"/>
       <Ellipse Width="16" Height="15" Canvas.Left="62" Canvas.Top="201" Fill="#94364B"/>
      </Canvas>
      <Ellipse Width="123" Height="24" Canvas.Left="99" Canvas.Top="254" Fill="#782E48"/>
      <Canvas Visibility="{Binding HasCat, Converter={StaticResource Visible}}">
       <Ellipse Width="92" Height="47" Canvas.Left="116" Canvas.Top="218" Fill="#DFC9A4"/>
       <Path Data="M110,234 L110,203 L128,215 L148,211 L162,197 L165,237Z" Fill="#DFC9A4"/>
       <Ellipse Width="58" Height="42" Canvas.Left="108" Canvas.Top="216" Fill="#EAD7B5"/>
       <Path Data="M118,233 Q123,239 129,233 M142,233 Q147,239 153,233 M131,242 L137,245 L141,241" Stroke="#493D3B" StrokeThickness="2"/>
       <Path Data="M189,245 Q226,258 203,228" Stroke="#C0A580" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Canvas>
      <Canvas Visibility="{Binding HasPainting, Converter={StaticResource Visible}}">
       <Rectangle Width="48" Height="59" Canvas.Left="240" Canvas.Top="213" Fill="#C8AB74"/>
       <Rectangle Width="38" Height="49" Canvas.Left="245" Canvas.Top="218" Fill="#D9E6E8"/>
       <Path Data="M246,259 L256,242 L265,251 L275,233 L281,261Z" Fill="#48768C"/>
       <Ellipse Width="9" Height="9" Canvas.Left="251" Canvas.Top="224" Fill="#A87842"/>
      </Canvas>
      <Rectangle Width="68" Height="10" Canvas.Left="211" Canvas.Top="291" Fill="#6E8B98"/>
      <Rectangle Width="64" Height="7" Canvas.Left="215" Canvas.Top="303" Fill="#C9B895"/>
     </Canvas>
     <StackPanel Grid.Row="2" Margin="12,0">
      <TextBlock Text="Room to be curious." FontFamily="Georgia" FontSize="24" Foreground="#F2E4CD"/>
      <TextBlock Text="{Binding CollectionNote}" Foreground="#C0D1DB" FontSize="13" LineHeight="21" Margin="0,14,0,0"/>
      <TextBlock Text="NO CLOCK. NO PRESSURE." Foreground="#CDBA94" FontSize="10" Margin="0,22,0,0"/>
     </StackPanel>
    </Grid>
   </Border>
   <Border Grid.Column="2" Background="#F5EFE3" CornerRadius="16" BorderBrush="#C5B89E" BorderThickness="1">
    <Grid Margin="36,28">
     <StackPanel Visibility="{Binding IsHome, Converter={StaticResource Visible}}">
      <TextBlock Text="THE PAINTER'S ATTENTION" FontSize="11" Foreground="#7B6546" Margin="0,5,0,18"/>
      <TextBlock Text="A mind full of colour." FontFamily="Georgia" FontSize="38"/>
      <TextBlock Text="Settle into the parlour for twelve tiny brushstrokes. A word says one thing; its ink may say another. Which will you follow?" FontSize="16" LineHeight="25" Margin="0,18,0,24"/>
      <Button Command="{Binding StartInk}" HorizontalContentAlignment="Left" Background="#244F73" Foreground="#FFF7E9" Padding="22,19">
       <StackPanel><TextBlock Text="01   Follow the ink" Foreground="#FFF7E9" FontFamily="Georgia" FontSize="22"/><TextBlock Text="Choose the colour you see. Let the word drift past." Foreground="#C8DAE4" Margin="0,7,0,0" FontSize="13"/></StackPanel>
      </Button>
      <Button Command="{Binding StartWord}" Margin="0,12,0,0" Padding="22,19">
       <StackPanel><TextBlock Text="02   Follow the word" FontFamily="Georgia" FontSize="22"/><TextBlock Text="A gentler variation: read the word, whatever its ink." Margin="0,7,0,0" FontSize="13"/></StackPanel>
      </Button>
      <TextBlock Text="A playful introduction to selective attention, inspired by the Stroop effect. Finish any sitting to collect a keepsake." FontSize="13" LineHeight="21" Foreground="#6C746F" Margin="0,25,0,0"/>
     </StackPanel>
     <Grid Visibility="{Binding IsPlaying, Converter={StaticResource Visible}}">
      <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="45"/><RowDefinition Height="180"/><RowDefinition Height="80"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel><Button Content="← Leave sitting" Command="{Binding Home}" Padding="9,5" FontSize="12" DockPanel.Dock="Right"/><TextBlock Text="{Binding Counter}" Foreground="#7B6546" FontSize="11" VerticalAlignment="Center"/></DockPanel>
      <TextBlock Grid.Row="1" Text="{Binding Rule}" FontFamily="Georgia" FontSize="23" VerticalAlignment="Center"/>
      <Border Grid.Row="2" Background="#FFFCF5" BorderBrush="#CDBF9F" BorderThickness="1" CornerRadius="12" Margin="0,12,0,10">
       <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Word}" Foreground="{Binding Ink}" FontFamily="Georgia" FontWeight="Bold" FontSize="59" HorizontalAlignment="Center"/><TextBlock Text="look gently · choose deliberately" Foreground="#8A8171" FontSize="11" HorizontalAlignment="Center" Margin="0,12,0,0"/></StackPanel>
      </Border>
      <UniformGrid Grid.Row="3" Columns="4" Margin="-4,10,-4,10">
       <Button Content="1 · Blue" Command="{Binding Answer}" CommandParameter="Blue" Background="#215B9A" Foreground="White" Margin="4,0" Padding="4,10"/>
       <Button Content="2 · Rose" Command="{Binding Answer}" CommandParameter="Rose" Background="#94364B" Foreground="White" Margin="4,0" Padding="4,10"/>
       <Button Content="3 · Green" Command="{Binding Answer}" CommandParameter="Green" Background="#35715C" Foreground="White" Margin="4,0" Padding="4,10"/>
       <Button Content="4 · Gold" Command="{Binding Answer}" CommandParameter="Gold" Background="#926715" Foreground="White" Margin="4,0" Padding="4,10"/>
      </UniformGrid>
      <StackPanel Grid.Row="4">
       <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Height="4" BorderThickness="0" Background="#DDD6C8" Foreground="#527B94" Margin="0,5,0,17"/>
       <TextBlock Text="{Binding Message}" FontSize="14" LineHeight="21" MinHeight="49"/>
       <Button Content="{Binding NextLabel}" Command="{Binding Next}" Visibility="{Binding HasFeedback, Converter={StaticResource Visible}}" HorizontalAlignment="Right" Margin="0,8,0,0" Background="#244F73" Foreground="#FFF7E9"/>
      </StackPanel>
     </Grid>
     <StackPanel Visibility="{Binding IsSummary, Converter={StaticResource Visible}}">
      <TextBlock Text="A SITTING WELL SPENT" Foreground="#7B6546" FontSize="11" Margin="0,5,0,18"/>
      <TextBlock Text="Let curiosity bloom." FontFamily="Georgia" FontSize="36"/>
      <TextBlock Text="{Binding Result}" FontSize="23" Margin="0,19,0,8"/>
      <TextBlock Text="{Binding Comparison}" FontSize="12"/>
      <Border BorderBrush="#CDBF9F" BorderThickness="0,1,0,1" Margin="0,23,0,20" Padding="0,18">
       <StackPanel><TextBlock Text="A note from the study" FontFamily="Georgia" FontSize="22"/>
       <TextBlock Text="In the classic Stroop effect, naming ink colours tends to take longer when the written word conflicts with the ink. Reading can compete with the colour-naming task." FontSize="14" LineHeight="22" Margin="0,12,0,0"/>
       <TextBlock Text="Did you notice a pull toward reading? This relaxed game does not measure response times, so these counts cannot establish a Stroop effect or assess your abilities." FontSize="13" LineHeight="21" Margin="0,12,0,0" Foreground="#6C746F"/></StackPanel>
      </Border>
      <TextBlock Text="{Binding Message}" FontSize="13" Margin="0,0,0,12"/>
      <Button Content="Retry saving keepsake" Command="{Binding RetrySave}" Visibility="{Binding SaveFailed, Converter={StaticResource Visible}}" Margin="0,0,0,8"/>
      <Button Content="Back to the parlour  →" Command="{Binding Home}" Background="#244F73" Foreground="#FFF7E9" HorizontalAlignment="Left"/>
     </StackPanel>
    </Grid>
   </Border>
  </Grid>
  <TextBlock Grid.Row="2" Text="AN EDUCATIONAL PLAYTHING, NOT A CLINICAL TEST.                         v0.1 · THE BLUE PARLOUR" Foreground="#AFC1CD" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
 </Grid>
 </Viewbox>
 </Border>
</Window>

