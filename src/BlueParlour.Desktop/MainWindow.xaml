<Window x:Class="BlueParlour.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:BlueParlour.Desktop"
 Icon="Assets/Parlour.ico" Title="The Blue Parlour" Width="1180" Height="800" MinWidth="820" MinHeight="600"
 Background="{Binding Background}" Foreground="#233B50" WindowStartupLocation="CenterScreen" PreviewKeyDown="OnKeyDown">
 <Border Background="{Binding Background}">
 <Viewbox Stretch="Uniform">
 <Grid Width="1140" Height="720" Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="24,0">
   <StackPanel VerticalAlignment="Center">
    <TextBlock Text="THE BLUE PARLOUR" Foreground="#F2E4CD" FontFamily="Georgia" FontSize="30"/>
    <TextBlock Text="A LITTLE CURIOSITY. A LITTLE COLOUR. A MOMENT FOR YOURSELF." Foreground="#ADC5D7" FontSize="10" Margin="1,9,0,0"/>
   </StackPanel>
   <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
    <Border BorderBrush="#7890A0" BorderThickness="1" CornerRadius="20" Padding="15,8" Margin="0,0,9,0"><TextBlock Text="{Binding Collection}" Foreground="#F0DEC0" FontSize="11"/></Border>
    <Button Command="{Binding StartCustomize}" Content="✦  Make it yours" Background="{Binding Accent}" Foreground="White" Padding="15,9"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="365"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{Binding SidePanel}" CornerRadius="22" BorderBrush="#7890A0" BorderThickness="1">
    <Border.Effect><DropShadowEffect Color="#06131D" BlurRadius="24" ShadowDepth="8" Opacity="0.35"/></Border.Effect>
    <Grid Margin="22">
     <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="330"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="{Binding CornerTitle}" Foreground="#E2CFAB" FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0"/>
     <Canvas Grid.Row="1" Width="318" Height="320" ClipToBounds="True">
      <!-- Original vector illustration: moonlit sash window, desk, sleeping cat. -->
      <Rectangle Width="220" Height="222" Canvas.Left="48" Canvas.Top="12" RadiusX="95" RadiusY="95" Fill="#A18E6D"/>
      <Rectangle Width="204" Height="206" Canvas.Left="56" Canvas.Top="20" RadiusX="90" RadiusY="90" Fill="#142E45"/>
      <Ellipse Width="38" Height="38" Canvas.Left="191" Canvas.Top="44" Fill="#E3D2AD"/>
      <Ellipse Width="33" Height="33" Canvas.Left="182" Canvas.Top="38" Fill="#142E45"/>
      <Path Data="M65,180 Q110,115 149,178 Q202,105 252,173 L252,220 L65,220Z" Fill="#355773"/>
      <Rectangle Width="6" Height="210" Canvas.Left="156" Canvas.Top="18" Fill="#A18E6D"/>
      <Rectangle Width="209" Height="6" Canvas.Left="54" Canvas.Top="124" Fill="#A18E6D"/>
      <Rectangle Width="240" Height="10" Canvas.Left="38" Canvas.Top="221" Fill="#C1AD86" RadiusX="3" RadiusY="3"/>
      <Rectangle Width="286" Height="13" Canvas.Left="16" Canvas.Top="278" Fill="#AD8C69" RadiusX="5" RadiusY="5"/>
      <Rectangle Width="10" Height="50" Canvas.Left="36" Canvas.Top="291" Fill="#806952"/>
      <Rectangle Width="10" Height="50" Canvas.Left="274" Canvas.Top="291" Fill="#806952"/>
      <Path Data="M37,273 L41,232 L69,232 L73,273Z" Fill="#A6C5D5"/>
      <Path Data="M55,237 L51,199 M54,224 L69,209 M53,216 L38,205" Stroke="#769582" StrokeThickness="3"/>
      <Canvas Visibility="{Binding HasRose, Converter={StaticResource Visible}}">
       <Ellipse Width="28" Height="23" Canvas.Left="37" Canvas.Top="183" Fill="#772B42"/>
       <Ellipse Width="17" Height="15" Canvas.Left="47" Canvas.Top="185" Fill="#A7475B"/>
       <Path Data="M47,197 Q57,183 59,199 Q46,207 43,194" Stroke="#D27A86" StrokeThickness="1.5"/>
       <Ellipse Width="16" Height="15" Canvas.Left="62" Canvas.Top="201" Fill="#94364B"/>
      </Canvas>
      <Ellipse Width="123" Height="24" Canvas.Left="99" Canvas.Top="254" Fill="#782E48"/>
      <Canvas Visibility="{Binding IsCat, Converter={StaticResource Visible}}">
       <Ellipse Width="92" Height="47" Canvas.Left="116" Canvas.Top="218" Fill="#DFC9A4"/>
       <Path Data="M110,234 L110,203 L128,215 L148,211 L162,197 L165,237Z" Fill="#DFC9A4"/>
       <Ellipse Width="58" Height="42" Canvas.Left="108" Canvas.Top="216" Fill="#EAD7B5"/>
       <Path Data="M118,233 Q123,239 129,233 M142,233 Q147,239 153,233 M131,242 L137,245 L141,241" Stroke="#493D3B" StrokeThickness="2"/>
       <Path Data="M189,245 Q226,258 203,228" Stroke="#C0A580" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Canvas>
      <Canvas Visibility="{Binding IsPug, Converter={StaticResource Visible}}">
       <Ellipse Width="105" Height="57" Canvas.Left="108" Canvas.Top="211" Fill="#C2A680"/>
       <Ellipse Width="61" Height="52" Canvas.Left="105" Canvas.Top="207" Fill="#D3BA95"/>
       <Ellipse Width="23" Height="31" Canvas.Left="105" Canvas.Top="203" Fill="#604A42"/>
       <Ellipse Width="23" Height="31" Canvas.Left="149" Canvas.Top="203" Fill="#604A42"/>
       <Ellipse Width="36" Height="29" Canvas.Left="118" Canvas.Top="226" Fill="#6A5047"/>
       <Ellipse Width="5" Height="5" Canvas.Left="120" Canvas.Top="220" Fill="#26343C"/><Ellipse Width="5" Height="5" Canvas.Left="148" Canvas.Top="220" Fill="#26343C"/>
       <Path Data="M129,241 Q136,248 144,241" Stroke="#F0D7B2" StrokeThickness="2"/>
       <Path Data="M205,232 Q228,214 218,249" Stroke="#C2A680" StrokeThickness="10" StrokeStartLineCap="Round"/>
      </Canvas>
      <Canvas Visibility="{Binding IsCorgi, Converter={StaticResource Visible}}">
       <Ellipse Width="112" Height="54" Canvas.Left="104" Canvas.Top="214" Fill="#D58A45"/>
       <Path Data="M103,235 L109,191 L133,214 L161,209 L181,190 L178,247Z" Fill="#D58A45"/>
       <Ellipse Width="62" Height="48" Canvas.Left="111" Canvas.Top="214" Fill="#F2D5A6"/>
       <Ellipse Width="5" Height="5" Canvas.Left="122" Canvas.Top="224" Fill="#26343C"/><Ellipse Width="5" Height="5" Canvas.Left="156" Canvas.Top="224" Fill="#26343C"/>
       <Path Data="M134,240 L142,246 L150,240" Stroke="#59413A" StrokeThickness="3"/>
       <Path Data="M208,232 Q232,213 221,250" Stroke="#D58A45" StrokeThickness="11" StrokeStartLineCap="Round"/>
      </Canvas>
      <Canvas Visibility="{Binding HasPainting, Converter={StaticResource Visible}}">
       <Rectangle Width="48" Height="59" Canvas.Left="240" Canvas.Top="213" Fill="#C8AB74"/>
       <Rectangle Width="38" Height="49" Canvas.Left="245" Canvas.Top="218" Fill="#D9E6E8"/>
       <Path Data="M246,259 L256,242 L265,251 L275,233 L281,261Z" Fill="#48768C"/>
       <Ellipse Width="9" Height="9" Canvas.Left="251" Canvas.Top="224" Fill="#A87842"/>
      </Canvas>
      <Rectangle Width="68" Height="10" Canvas.Left="211" Canvas.Top="291" Fill="#6E8B98"/>
      <Rectangle Width="64" Height="7" Canvas.Left="215" Canvas.Top="303" Fill="#C9B895"/>
     </Canvas>
     <StackPanel Grid.Row="2" Margin="12,0">
      <TextBlock Text="Room to be curious." FontFamily="Georgia" FontSize="24" Foreground="#F2E4CD"/>
      <TextBlock Text="{Binding CollectionNote}" Foreground="#C0D1DB" FontSize="13" LineHeight="21" Margin="0,14,0,0"/>
      <TextBlock Text="NO CLOCK. NO PRESSURE." Foreground="#CDBA94" FontSize="10" Margin="0,22,0,0"/>
     </StackPanel>
    </Grid>
   </Border>
   <Border Grid.Column="2" Background="{Binding Surface}" CornerRadius="22" BorderBrush="#C5B89E" BorderThickness="1">
    <Border.Effect><DropShadowEffect Color="#06131D" BlurRadius="28" ShadowDepth="9" Opacity="0.3"/></Border.Effect>
    <Grid Margin="36,28">
     <StackPanel Visibility="{Binding IsHome, Converter={StaticResource Visible}}">
      <TextBlock Text="YOUR PARLOUR · YOUR PACE" FontSize="10" Foreground="#7B6546" Margin="0,0,0,9"/>
      <TextBlock Text="What feels right tonight?" FontFamily="Georgia" FontSize="34"/>
      <TextBlock Text="Choose a challenge or a pause. Every card is an invitation; leaving is always allowed." FontSize="14" LineHeight="22" Margin="0,8,0,14"/>
      <UniformGrid Columns="2" Rows="2" Margin="-5">
       <Button Command="{Binding StartOpera}" Background="{Binding Accent}" Foreground="#FFF7E9" Margin="5" Padding="17" Height="118" HorizontalContentAlignment="Left">
        <StackPanel><TextBlock Text="◐  Midnight Opera" Foreground="#FFF7E9" FontFamily="Georgia" FontSize="21"/><TextBlock Text="3 acts · hidden pairs" Foreground="#D7E4E9" Margin="0,8,0,0"/><TextBlock Text="Memory + mastery" Foreground="#D7E4E9" FontSize="11" Margin="0,3,0,0"/></StackPanel>
       </Button>
       <Button Command="{Binding StartShift}" Background="{Binding AccentSoft}" Margin="5" Padding="17" Height="118" HorizontalContentAlignment="Left">
        <StackPanel><TextBlock Text="↔  Shifting Spotlight" FontFamily="Georgia" FontSize="21"/><TextBlock Text="Rules change as you play" Margin="0,8,0,0"/><TextBlock Text="Inhibition + switching" FontSize="11" Foreground="#65747A" Margin="0,3,0,0"/></StackPanel>
       </Button>
       <Button Command="{Binding StartInk}" Margin="5" Padding="17" Height="105" HorizontalContentAlignment="Left">
        <StackPanel><TextBlock Text="◉  Ink in memory" FontFamily="Georgia" FontSize="20"/><TextBlock Text="Answer from one card back" Margin="0,7,0,0"/><TextBlock Text="{Binding DepthName}" FontSize="11" Foreground="#65747A" Margin="0,3,0,0"/></StackPanel>
       </Button>
       <Button Command="{Binding StartWord}" Margin="5" Padding="17" Height="105" HorizontalContentAlignment="Left">
        <StackPanel><TextBlock Text="Aa  Words in memory" FontFamily="Georgia" FontSize="20"/><TextBlock Text="Hold the previous word" Margin="0,7,0,0"/><TextBlock Text="{Binding DepthName}" FontSize="11" Foreground="#65747A" Margin="0,3,0,0"/></StackPanel>
       </Button>
      </UniformGrid>
      <Button Command="{Binding StartQuiet}" Background="Transparent" BorderBrush="{Binding Accent}" Margin="0,10,0,0" Padding="13,10" HorizontalContentAlignment="Left"><DockPanel><TextBlock Text="→" DockPanel.Dock="Right" FontSize="18"/><TextBlock Text="A quiet moment · choose one of three reflection paths" FontSize="13"/></DockPanel></Button>
     </StackPanel>
     <Grid Visibility="{Binding IsCustomize, Converter={StaticResource Visible}}">
      <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Button Content="← Done" Command="{Binding Home}" Padding="10,5" HorizontalAlignment="Right"/>
      <StackPanel Grid.Row="1" Margin="8,12,8,0">
       <TextBlock Text="MAKE IT YOURS" FontSize="10" Foreground="#7B6546"/>
       <TextBlock Text="A room that answers to you." FontFamily="Georgia" FontSize="31" Margin="0,8,0,6"/>
       <TextBlock Text="Change anything as often as you like. Choices save immediately." FontSize="13" Foreground="#65747A" Margin="0,0,0,18"/>
       <TextBlock Text="ATMOSPHERE" FontSize="10" Foreground="#7B6546" Margin="0,0,0,7"/>
       <UniformGrid Columns="3">
        <Button Content="Midnight blue" Command="{Binding SetPalette}" CommandParameter="Midnight" Background="#173B59" Foreground="White" Margin="0,0,5,0"/>
        <Button Content="Rose velvet" Command="{Binding SetPalette}" CommandParameter="RoseVelvet" Background="#71364D" Foreground="White" Margin="5,0"/>
        <Button Content="Sage glass" Command="{Binding SetPalette}" CommandParameter="SageGlass" Background="#446E65" Foreground="White" Margin="5,0,0,0"/>
       </UniformGrid>
       <TextBlock Text="COMPANION" FontSize="10" Foreground="#7B6546" Margin="0,20,0,7"/>
       <UniformGrid Columns="3">
        <Button Content="Cat" Command="{Binding SetCompanion}" CommandParameter="Cat" Margin="0,0,5,0"/>
        <Button Content="Pug" Command="{Binding SetCompanion}" CommandParameter="Pug" Margin="5,0"/>
        <Button Content="Corgi" Command="{Binding SetCompanion}" CommandParameter="Corgi" Margin="5,0,0,0"/>
       </UniformGrid>
       <TextBlock Text="FOCUS DEPTH" FontSize="10" Foreground="#7B6546" Margin="0,20,0,7"/>
       <UniformGrid Columns="2">
        <Button Command="{Binding SetDepth}" CommandParameter="Focused" Margin="0,0,5,0" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="Focused" FontFamily="Georgia" FontSize="18"/><TextBlock Text="16 one-back · 18 shifting" FontSize="11"/></StackPanel></Button>
        <Button Command="{Binding SetDepth}" CommandParameter="Deep" Margin="5,0,0,0" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="Deep" FontFamily="Georgia" FontSize="18"/><TextBlock Text="24 one-back · 36 shifting" FontSize="11"/></StackPanel></Button>
       </UniformGrid>
       <Border Background="{Binding AccentSoft}" CornerRadius="12" Padding="15" Margin="0,20,0,0"><StackPanel><TextBlock Text="CURRENT ROOM" FontSize="9" Foreground="#65747A"/><TextBlock FontFamily="Georgia" FontSize="18" Margin="0,5,0,0"><Run Text="{Binding PaletteName, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding CompanionName, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding DepthName, Mode=OneWay}"/></TextBlock><TextBlock Text="{Binding Message}" FontSize="11" Margin="0,6,0,0"/></StackPanel></Border>
      </StackPanel>
     </Grid>
     <Grid Visibility="{Binding IsOpera, Converter={StaticResource Visible}}">
      <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Button Content="← Back to the parlour" Command="{Binding Home}" Padding="8,4" HorizontalAlignment="Right" FontSize="11"/>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><local:OperaView DataContext="{Binding Opera}"/></ScrollViewer>
     </Grid>
     <Grid Visibility="{Binding IsQuiet, Converter={StaticResource Visible}}">
      <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Button Content="← Back to the parlour" Command="{Binding Home}" Padding="8,4" HorizontalAlignment="Right" FontSize="11"/>
      <StackPanel Grid.Row="1" DataContext="{Binding Quiet}" Margin="10,24,10,0">
       <TextBlock Text="{Binding Counter}" FontSize="11" Foreground="#7B6546"/>
       <TextBlock Text="{Binding Title}" FontFamily="Georgia" FontSize="33" Margin="0,12,0,18"/>
       <StackPanel Visibility="{Binding IsChoosing, Converter={StaticResource Visible}}">
        <TextBlock Text="There is no prescribed route. Pick what seems useful now; you can return and choose differently." FontSize="14" LineHeight="22" Margin="0,0,0,14"/>
        <Button Command="{Binding ChoosePath}" CommandParameter="Notice" HorizontalContentAlignment="Left" Padding="18,14" Margin="0,0,0,8"><StackPanel><TextBlock Text="01  Notice the room" FontFamily="Georgia" FontSize="20"/><TextBlock Text="Colours, support, texture and sound" FontSize="12" Margin="0,4,0,0"/></StackPanel></Button>
        <Button Command="{Binding ChoosePath}" CommandParameter="GentleVoice" HorizontalContentAlignment="Left" Padding="18,14" Margin="0,0,0,8"><StackPanel><TextBlock Text="02  A gentler voice" FontFamily="Georgia" FontSize="20"/><TextBlock Text="Effort, perspective and a sentence worth keeping" FontSize="12" Margin="0,4,0,0"/></StackPanel></Button>
        <Button Command="{Binding ChoosePath}" CommandParameter="OpenEnding" HorizontalContentAlignment="Left" Padding="18,14"><StackPanel><TextBlock Text="03  Leave an ending open" FontFamily="Georgia" FontSize="20"/><TextBlock Text="One useful step; one question allowed to wait" FontSize="12" Margin="0,4,0,0"/></StackPanel></Button>
       </StackPanel>
       <StackPanel Visibility="{Binding IsMoment, Converter={StaticResource Visible}}">
        <Border Background="#DFE9E9" CornerRadius="18" Padding="28" MinHeight="182"><TextBlock Text="{Binding Prompt}" FontSize="20" LineHeight="31" VerticalAlignment="Center"/></Border>
        <TextBlock Text="Nothing is recorded. Keep, skip, or leave any invitation." FontSize="12" Foreground="#6C746F" Margin="0,17,0,12"/>
        <StackPanel Orientation="Horizontal">
         <Button Content="Continue or skip  →" Command="{Binding Next}" Visibility="{Binding NotComplete, Converter={StaticResource Visible}}" Background="#244F73" Foreground="White" Margin="0,0,8,0"/>
         <Button Content="Begin this path again  ↻" Command="{Binding Restart}" Visibility="{Binding Complete, Converter={StaticResource Visible}}" Margin="0,0,8,0"/>
         <Button Content="Choose another path" Command="{Binding BackToPaths}"/>
        </StackPanel>
       </StackPanel>
      </StackPanel>
     </Grid>
     <Grid Visibility="{Binding IsPlaying, Converter={StaticResource Visible}}">
      <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="45"/><RowDefinition Height="180"/><RowDefinition Height="80"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel><Button Content="← Leave sitting" Command="{Binding Home}" Padding="9,5" FontSize="12" DockPanel.Dock="Right"/><TextBlock Text="{Binding Counter}" Foreground="#7B6546" FontSize="11" VerticalAlignment="Center"/></DockPanel>
      <TextBlock Grid.Row="1" Text="{Binding Rule}" FontFamily="Georgia" FontSize="23" VerticalAlignment="Center"/>
      <Border Grid.Row="2" Background="#FFFCF5" BorderBrush="#CDBF9F" BorderThickness="1" CornerRadius="12" Margin="0,12,0,10">
       <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Word}" Foreground="{Binding Ink}" FontFamily="Georgia" FontWeight="Bold" FontSize="59" HorizontalAlignment="Center"/><TextBlock Text="look gently · choose deliberately" Foreground="#8A8171" FontSize="11" HorizontalAlignment="Center" Margin="0,12,0,0"/></StackPanel>
      </Border>
      <UniformGrid Grid.Row="3" Columns="4" Margin="-4,10,-4,10">
       <Button Content="1 · Blue" Command="{Binding Answer}" CommandParameter="Blue" Background="#215B9A" Foreground="White" Margin="4,0" Padding="4,10"/>
       <Button Content="2 · Rose" Command="{Binding Answer}" CommandParameter="Rose" Background="#94364B" Foreground="White" Margin="4,0" Padding="4,10"/>
       <Button Content="3 · Green" Command="{Binding Answer}" CommandParameter="Green" Background="#35715C" Foreground="White" Margin="4,0" Padding="4,10"/>
       <Button Content="4 · Gold" Command="{Binding Answer}" CommandParameter="Gold" Background="#926715" Foreground="White" Margin="4,0" Padding="4,10"/>
      </UniformGrid>
      <StackPanel Grid.Row="4">
       <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Height="4" BorderThickness="0" Background="#DDD6C8" Foreground="#527B94" Margin="0,5,0,17"/>
       <TextBlock Text="{Binding Message}" FontSize="14" LineHeight="21" MinHeight="49"/>
       <Button Content="{Binding NextLabel}" Command="{Binding Next}" Visibility="{Binding HasFeedback, Converter={StaticResource Visible}}" HorizontalAlignment="Right" Margin="0,8,0,0" Background="#244F73" Foreground="#FFF7E9"/>
      </StackPanel>
     </Grid>
     <StackPanel Visibility="{Binding IsSummary, Converter={StaticResource Visible}}">
      <TextBlock Text="A SITTING WELL SPENT" Foreground="#7B6546" FontSize="11" Margin="0,5,0,18"/>
      <TextBlock Text="Let curiosity bloom." FontFamily="Georgia" FontSize="36"/>
      <TextBlock Text="{Binding Result}" FontSize="23" Margin="0,19,0,8"/>
      <TextBlock Text="{Binding Comparison}" FontSize="12"/>
      <Border BorderBrush="#CDBF9F" BorderThickness="0,1,0,1" Margin="0,23,0,20" Padding="0,18">
       <StackPanel><TextBlock Text="A note from the study" FontFamily="Georgia" FontSize="22"/>
       <TextBlock Text="In the classic Stroop effect, naming ink colours tends to take longer when the written word conflicts with the ink. Reading can compete with the colour-naming task." FontSize="14" LineHeight="22" Margin="0,12,0,0"/>
       <TextBlock Text="Did you notice a pull toward reading? This relaxed game does not measure response times, so these counts cannot establish a Stroop effect or assess your abilities." FontSize="13" LineHeight="21" Margin="0,12,0,0" Foreground="#6C746F"/></StackPanel>
      </Border>
      <TextBlock Text="{Binding Message}" FontSize="13" Margin="0,0,0,12"/>
      <Button Content="Retry saving keepsake" Command="{Binding RetrySave}" Visibility="{Binding SaveFailed, Converter={StaticResource Visible}}" Margin="0,0,0,8"/>
      <Button Content="Back to the parlour  →" Command="{Binding Home}" Background="#244F73" Foreground="#FFF7E9" HorizontalAlignment="Left"/>
     </StackPanel>
    </Grid>
   </Border>
  </Grid>
  <TextBlock Grid.Row="2" Text="AN EDUCATIONAL PLAYTHING, NOT A CLINICAL TEST.                         v0.4 · THE BLUE PARLOUR" Foreground="#AFC1CD" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
 </Grid>
 </Viewbox>
 </Border>
</Window>

